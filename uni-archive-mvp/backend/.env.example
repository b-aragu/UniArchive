# ========================
# Database
# ========================
DATABASE_URL=postgresql://uniarchive:uniarchive@localhost:5432/uniarchive

# ========================
# File Storage
# ========================
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=50

# ========================
# Authentication
# ========================
JWT_SECRET=super_secret_jwt_key_for_development_only_change_in_prod
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ========================
# Optional AI Study Assistant
# ========================
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
LLM_MODEL=gemini-1.5-flash
LLM_TEXT_LIMIT=10000